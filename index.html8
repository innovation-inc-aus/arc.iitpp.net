/* Classic first program — compiled with MIPSpro C 7.3.1 */
int main() {
    int i;
    printf("Hello, Innovation Inc Thermal Power Plant!\\n");
    for (i = 0; i < 5; i++) {
        printf("  loop iteration %d\\n", i + 1);
    }
    printf("Core nominal. Safeguard READY.\\n");
    return 0;
}
`,fib:`#include <stdio.h>

/* Recursive fibonacci — tests calls, params and arithmetic */
int fib(int n) {
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}

int main() {
    int i;
    for (i = 0; i < 15; i++) {
        printf("fib(%d) = %d\\n", i, fib(i));
    }
    return 0;
}
`,reactor:`#include <stdio.h>
#include <math.h>

/* Reactor core temperature simulation */
float core_temp = 2180.0;

int main() {
    int t;
    float coolant = 420.0;
    for (t = 0; t < 10; t++) {
        core_temp = core_temp + (core_temp > 2500.0 ? -120.0 : 60.0);
        coolant = coolant - 8.0;
        printf("t=%d  core=%.0fK  coolant=%.0f L/s  sqrt=%f\\n",
               t, core_temp, coolant, sqrt(coolant));
    }
    printf("Final core temperature: %.1f K\\n", core_temp);
    return 0;
}
`,makefile:`# Makefile for IITPP researcher projects
CC = cc
CFLAGS = -O2 -n32 -mips3

all: hello fib reactor

hello: hello.c
	$(CC) $(CFLAGS) -o hello hello.c

fib: fib.c
	$(CC) $(CFLAGS) -o fib fib.c

reactor: reactor.c
	$(CC) $(CFLAGS) -lm -o reactor reactor.c

clean:
	rm -f hello fib reactor *.o
`,thermo:`C     THERMAL.F - reactor coolant loop heat-transfer model
C     MIPSpro f77 7.3.1 - fixed form, columns 1-72
      PROGRAM THERMAL
      INTEGER I
      REAL TEMP, COOL, DELTA
      TEMP = 2180.0
      COOL = 420.0
      DELTA = 12.0
      PRINT *, 'Initial core temperature ', TEMP, ' K'
      DO 10 I = 1, 10
        TEMP = TEMP + DELTA
        COOL = COOL - 8.0
        PRINT *, 'cycle ', I, ': core ', TEMP, ' K  coolant ', COOL
   10 CONTINUE
      PRINT *, 'Final core temperature ', TEMP, ' K'
      STOP
      END
