/g"];return{lines:[`Launch speed (v₀)     = ${q(o)} m/s`,`Launch angle (θ)      = ${rt(he(i,"angle"),1)}°`,`Gravity (g)           = ${q(f)} m/s²`,`Initial height        = ${q(d)} m`,"─────────────────────────────",`v_x = ${q(p)} m/s   v_y = ${q(m)} m/s`,`Time of flight        = ${q(y)} s`,`Range (R)             = ${q(S)} m`,`Maximum height        = ${q(C)} m`],values:[S,C,y],labels:["range (m)","height (m)","time (s)"],equations:T}}case"orbit":{const o=66743e-15,c=he(i,"mass"),f=he(i,"radius"),d=he(i,"altitude"),p=f+d,m=Math.sqrt(o*c/p),y=2*Math.PI*p/m,S=Math.sqrt(2)*m,C=["v_orb = √(GM/r)","T = 2πr/v","v_esc = √2 · v_orb"];return{lines:[`Central body mass     = ${q(c)} kg`,`Body radius           = ${q(f/1e3)} km`,`Orbit altitude        = ${q(d/1e3)} km`,`Orbital radius (r)    = ${q(p/1e3)} km`,"─────────────────────────────",`Orbital velocity      = ${q(m)} m/s  (${q(m*3.6)} km/h)`,`Orbital period        = ${q(y)} s  (${q(y/60)} min, ${q(y/3600)} h)`,`Escape velocity       = ${q(S)} m/s`],values:[m,y/60,S],labels:["v_orb (m/s)","T (min)","v_esc (m/s)"],equations:C}}case"optics":{const o=he(i,"f"),c=he(i,"u"),f=he(i,"n"),d=1/(1/o-1/c),p=-d/c,m=1/o,y=["1/f = 1/u + 1/v","M = -v/u","P = 1/f (diopters)"];return{lines:[`Focal length (f)      = ${q(o*1e3)} mm (${q(o)} m)`,`Object distance (u)   = ${q(c*100)} cm`,`Refractive index (n)  = ${q(f)}`,"─────────────────────────────",`Image distance (v)    = ${q(d)} m  (${d>0?"real":"virtual"}, ${p>0?"upright":"inverted"})`,`Magnification (M)     = ${q(p)}×`,`Lens power            = ${q(m)} D`],values:[d,p,m],labels:["v (m)","M","D"],equations:y}}case"decay":{const o=he(i,"N0"),c=he(i,"tHalf"),f=he(i,"t"),d=Math.log(2)/c,p=o*Math.exp(-d*f),m=["N(t) = N₀e^(-λt)","λ = ln(2)/t₁/₂"];return{lines:[`Initial activity (N₀) = ${q(o)}`,`Half-life (t₁/₂)     = ${q(c)}`,`Elapsed time (t)      = ${q(f)}`,"─────────────────────────────",`Decay constant (λ)    = ${q(d)} per unit time`,`Remaining (N)         = ${q(p)}`,`Decayed               = ${q(o-p)} (${rt((o-p)/o*100,1)}%)`,`Half-lives elapsed    = ${rt(f/c,2)}`],values:[p,o-p,f/c],labels:["remaining","decayed","half-lives"],equations:m}}case"molar-mass":{const{total:o,atoms:c,error:f}=kx(i.formula??"H2O");return f?{lines:[`ERROR: ${f}`],values:[],labels:[],equations:["M = Σ(atomic_mass × count)"]}:{lines:[`Formula: ${i.formula}`,`Composition: ${c.join(" + ")}`,"─────────────────────────────",`Molar mass = ${q(o,6)} g/mol`,`Mass per mole = ${q(o,6)} g`,`Number of atoms in formula: ${c.length} element types`],values:[o],labels:["g/mol"],equations:["M = Σ a_i · m_i  where a_i = atom count, m_i = atomic mass"]}}case"ideal-gas":{const o=he(i,"P"),c=he(i,"V"),f=he(i,"n"),d=he(i,"T"),p=8.314462618,m=f*p*d/c,y=f*p*d/o,S=o*c/(p*d),C=o*c/(f*p),T=o*.02897/(p*d),g=["PV = nRT","R = 8.314 J/(mol·K)"];return{lines:[`P = ${q(o)} Pa   V = ${q(c)} m³   n = ${q(f)} mol   T = ${q(d)} K`,"─────────────────────────────",`PV = ${q(o*c)} J`,`nRT = ${q(f*p*d)} J`,`Solve P: ${q(m)} Pa`,`Solve V: ${q(y)} m³`,`Solve n: ${q(S)} mol`,`Solve T: ${q(C)} K`,`Air density ≈ ${q(T)} kg/m³`],values:[o*c,f*p*d],labels:["PV (J)","nRT (J)"],equations:g}}case"buffer-ph":{const o=he(i,"pKa"),c=he(i,"cA"),f=he(i,"cB"),d=c>0&&f>0?o+Math.log10(f/c):NaN,p=["pH = pKa + log([A⁻]/[HA])  (Henderson–Hasselbalch)"];return{lines:[`pKa                  = ${q(o)}`,`[HA] (acid)          = ${q(c)} M`,`[A⁻] (conjugate base)= ${q(f)} M`,"─────────────────────────────",`Ratio [A⁻]/[HA]      = ${q(f/c)}`,`pH                   = ${isNaN(d)?"undefined (check inputs)":q(d,4)}`,"Buffer capacity info: effective range is pKa ± 1"],values:[isNaN(d)?0:d,f/c],labels:["pH","ratio"],equations:p}}case"reaction":{const o=he(i,"mReactant"),c=he(i,"molarMassR"),f=he(i,"molarMassP"),d=he(i,"stoichR"),p=he(i,"stoichP"),m=o/c,y=m*(p/d),S=y*f,C=["mol = mass / molar_mass","mol_product = mol_reactant × (stoich_P / stoich_R)","mass_product = mol_product × molar_mass_P"];return{lines:[`Reactant mass         = ${q(o)} g`,`Reactant mol