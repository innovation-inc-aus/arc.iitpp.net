Designer`,icon:"🧊",app:"cad3d"}],og=[{id:1,title:"Core Temperature Stability Analysis",author:"Dr. Y. Tanaka",date:"2026-07-30",status:"Published",citations:24,abstract:"A longitudinal study of core thermal stability under sustained 850 MW output. Demonstrates that the current lava-crystal fuel configuration maintains ±12K variance over 72-hour windows, well within the 3000K safety ceiling. Proposes a predictive model using coolant flow as a leading indicator of thermal excursion risk."},{id:2,title:"Laser Alignment Optimization Study",author:"Researcher Team",date:"2026-07-29",status:"In Review",citations:7,abstract:"Evaluates the drift characteristics of the four secondary power lasers. The new feedback-alignment algorithm reduces RMS drift by 15.3% versus the 2025 baseline. Includes a proposed hardware revision to the gimbal mounts that would further stabilize long-duration burns."},{id:3,title:"Coolant Flow Dynamics at High RPM",author:"Dr. J. Mitchell",date:"2026-07-28",status:"Published",citations:31,abstract:"Cross-facility analysis of coolant pump cavitation across the Arctic and Sakurajima sites. Identifies a 72-hour pump cycling protocol that eliminates cavitation-related efficiency loss, lifting sustained cooling efficiency from 91% to 96% in sub-zero ambient conditions."},{id:4,title:"Radiation Containment Effectiveness",author:"Dr. R. Kim",date:"2026-07-27",status:"Published",citations:18,abstract:"Quarterly audit of the containment shield. Measured ambient radiation at 3.2 μSv/h against a 50 μSv/h sustained rating. Confirms shield integrity across all eight sectors, with a single anomalous reading in Sector C attributed to a dosimeter calibration error."},{id:5,title:"Emergency Safeguard Response Times",author:"Safety Division",date:"2026-07-26",status:"Draft",citations:0,abstract:"Benchmark testing of the dual-key safeguard activation chain. Full engagement completes in 4.2 seconds from key turn to cooling-rod insertion. Probability-of-success model included: 95% below 2500K, degrading to 30% at 3500K."},{id:6,title:"Magma Crystal Energy Density Report",author:"Dr. Y. Tanaka",date:"2026-07-25",status:"Published",citations:42,abstract:"Characterizes the energy density of Sakurajima magma crystals used as primary fuel. Measured specific energy of 3.4 GJ/kg at 2200K operating temperature, with a theoretical ceiling of 4.1 GJ/kg. Includes handling and storage safety recommendations for the Distribution division."}],cg=[{name:"Sector A — Main Entrance",nextArrival:132,pax:12,status:"ACTIVE"},{name:"Sector B — Research Wing",nextArrival:310,pax:8,status:"ACTIVE"},{name:"Sector C — Core Control",nextArrival:64,pax:3,status:"ACTIVE"},{name:"Sector D — Facility Control",nextArrival:186,pax:15,status:"ACTIVE"},{name:"Evacuation Hub",nextArrival:9999,pax:0,status:"STANDBY"}];function ug(){const u=["Sector A","Sector B","Sector C","Sector D","Evac Hub"],i=[];for(let o=2841;o<2849;o++)i.push({id:o,type:o%2?"cube":"barrel",dest:u[o%5],eta:60+o*37%180,status:"queued"});return i}const fg=[{text:"Core temperature nominal. All systems operational.",priority:"Normal"},{text:"Attention: Coolant flow at 94% efficiency. No action required.",priority:"Low"},{text:"Shift change in 30 minutes. Please prepare handover reports.",priority:"Normal"},{text:"Fire suppression test complete. All sectors clear.",priority:"Normal"},{text:"Tram arriving at Sector C in 1 minute.",priority:"Low"},{text:"Code Yellow standby: Safeguard system ready.",priority:"Code Yellow"},{text:"Unauthorized activity detected in Sector C. Security has been notified.",priority:"Code Yellow"},{text:"CODE RED — Core temperature exceeds 3000K. Evacuate Sector C immediately.",priority:"Code Red"}];function Ci(u){const i={...u,children:u.children?u.children.map(Ci):void 0};return i.type==="file"&&i.content===void 0&&(i.content=sh(i.name)),i}function ih(){return Ci(sg)}function sh(u){return{"doors.sys":`DOOR CONTROL SYSTEM v2.1 — IITPP Visitor Center
